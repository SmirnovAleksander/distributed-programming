@page
@model Valuator.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<h3>Регистрация</h3>
<form method="post">
    <p>
        <label>Логин</label>
        <input asp-for="RegisterUsername" />
    </p>
    <p>
        <label>Пароль</label>
        <input asp-for="RegisterPassword" type="password" />
    </p>
    @if (!string.IsNullOrEmpty(Model.AuthMessage))
    {
        <p>@Model.AuthMessage</p>
    }
    <button type="submit">Зарегистрироваться</button>
</form>
