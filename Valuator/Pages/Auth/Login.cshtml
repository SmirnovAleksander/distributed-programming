@page
@model Valuator.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<h3>Вход</h3>
<form method="post">
    <p>
        <label>Логин</label>
        <input asp-for="LoginUsername" />
    </p>
    <p>
        <label>Пароль</label>
        <input asp-for="LoginPassword" type="password" />
    </p>
    @if (!string.IsNullOrEmpty(Model.AuthMessage))
    {
        <p>@Model.AuthMessage</p>
    }
    <button type="submit">Войти</button>
</form>
