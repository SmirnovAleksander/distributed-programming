@page
@model Valuator.Pages.SummaryModel
@{
}
@if (!Model.RankReady)
{
    <p id="rank-status">Оценка содержания не завершена</p>
}
else
{
    <p id="rank-status">Оценка содержания: <span id="rank-value">@Model.Rank</span></p>
}
<p>Плагиат: @Model.Similarity</p>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    (function () {
        const summaryId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SummaryId));
        if (!summaryId) {
            return;
        }

        const rankStatus = document.getElementById("rank-status");
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/rank-updates")
            .withAutomaticReconnect()
            .build();

        connection.on("rankUpdated", function (rank) {
            rankStatus.innerHTML = "Оценка содержания: <span id=\"rank-value\">" + rank + "</span>";
        });

        connection.start()
            .then(function () {
                return connection.invoke("SubscribeToSummary", summaryId);
            })
            .catch(function (err) {
                console.error(err);
            });
    })();
</script>
